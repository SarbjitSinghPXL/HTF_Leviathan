{
  "name": "app",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "dev": "bun run --watch src/index.ts",
    "start": "bun src/index.ts",
    "build:check": "bun build src/index.ts src/db/migrate.ts src/db/seed.ts --target=bun --outdir=.build-check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:migrate:status": "bun src/db/migrate.ts --status",
    "db:seed": "bun src/db/seed.ts",
    "db:seed:status": "bun src/db/seed.ts --status"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/jwt": "^1.2.0",
    "@elysiajs/swagger": "^1.2.2",
    "drizzle-orm": "^0.40.0",
    "elysia": "^1.2.25",
    "mysql2": "^3.13.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "bun-types": "latest",
    "dotenv": "16.4.7",
    "drizzle-kit": "^0.30.5"
  },
  "module": "src/index.js"
}