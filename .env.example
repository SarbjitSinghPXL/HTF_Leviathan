# ────────────────────────────────────────────────────────────────────────────
# HTF Leviathan environment variables — EXAMPLE ONLY, no real secrets here.
#
# Local Docker Compose:  cp .env.example db.env   (db.env is git-ignored)
# Kubernetes:            secrets go into the htf-db / htf-api Secrets and the rest into
#                        the api-config ConfigMap (deploy/k8s/base/api.yaml), see
#                        docs/deployment.md. Never commit real values or bake them into images.
# ────────────────────────────────────────────────────────────────────────────

# ── MariaDB container (official image creates DB + user on first start) ─────
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=htf
MARIADB_USER=htf
MARIADB_PASSWORD=change-me-app

# ── API database connection ──────────────────────────────────────────────────
# The API reads DB_* first and falls back to the MYSQL_* names used by the old db.env.
DB_HOST=db-htf            # Compose service name; Kubernetes uses "mariadb"
DB_PORT=3306
DB_NAME=htf
DB_USER=htf
DB_PASSWORD=change-me-app
# MYSQL_DATABASE=htf      # legacy aliases, still supported
# MYSQL_USER=htf
# MYSQL_PASSWORD=change-me-app
# DB_POOL_SIZE=10
# DB_CONNECT_ATTEMPTS=10
# DB_CONNECT_RETRY_MS=3000

# ── Captain chat (OpenAI) ───────────────────────────────────────────────────
# Leave empty to run without chat (the endpoint then returns 503 "disabled").
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=20000
# CHAT_ENABLED=true
# CHAT_RATE_LIMIT_PER_IP_PER_MINUTE=6
# CHAT_RATE_LIMIT_GLOBAL_PER_MINUTE=30
# CHAT_DAILY_LIMIT=500

# ── API behaviour ───────────────────────────────────────────────────────────
# PORT=3000
# SWAGGER_ENABLED=true          # false in Kubernetes
# METRICS_ENABLED=true
# TRUST_PROXY_HEADERS=true      # API is always behind Traefik
# MAX_REQUEST_BODY_BYTES=16384
# SHUTDOWN_TIMEOUT_SECONDS=10
# CHAOS_DELAY_ENABLED=false     # Compose sets true (original hackathon latency)
# CHAOS_MIN_DELAY_MS=300
# CHAOS_MAX_DELAY_MS=750
# CHAOS_ERRORS_ENABLED=false
# CHAOS_DEBUG=false

# ── One-off database jobs only (never set permanently) ──────────────────────
# MIGRATE_BASELINE_EXISTING=false  # adopt a schema created by the old `drizzle-kit push`
# SEED_ADOPT_EXISTING=false        # record seeds as applied for data seeded by the old startup script

# JWT_SECRET (old jwt.env) is not used by any code and is no longer required.
